# What bin/init needs to know of the omnimeet family.
core=omnisense/omnimeet
core_repo=omnimeet
core_constraint=^1.0
vendor_ns=Omnimeet
branch=1.x
# No conformance suite wired: the skeleton's gateway has no action yet (every request refused).
contract=''
# A class of the core: BareTest finds the core's folder by it (a path repository's checkout).
core_class='Omnimeet\Registry'
# The class the CI loads and BareTest starts from: omnimeet names its factories <Name>GatewayFactory.
entry='__Name__GatewayFactory'
