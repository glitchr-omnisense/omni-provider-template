# What bin/init needs to know of the omnilab family.
core=omnisense/omnilab
core_repo=omnilab
core_constraint=^1.0
vendor_ns=Omnilab
branch=1.x
# No conformance suite wired: the skeleton answers nothing yet (each operation says "not written").
contract=''
# A class of the core: BareTest finds the core's folder by it (a path repository's checkout).
core_class='Omnilab\Registry'
# The class the CI loads and BareTest starts from: omnilab names its factories <Name>SourceFactory.
entry='__Name__SourceFactory'
