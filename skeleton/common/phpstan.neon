# PHPStan at the highest level, as glitchr-studio/ci's workflow runs it, tests included.
# phpstan-baseline.neon is empty from the first commit and stays so: anything PHPStan reports fails
# the CI. A decoded answer is read through Data (or the family's reader), never a cast of mixed.
includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - .
    excludePaths:
        - vendor (?)
    reportUnmatchedIgnoredErrors: false
