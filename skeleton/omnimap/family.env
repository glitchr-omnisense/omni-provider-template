# What bin/init needs to know of the omnimap family.
core=omnisense/omnimap
core_repo=omnimap
core_constraint=^1.0@dev
vendor_ns=Omnimap
branch=1.x
contract=ProviderContractTests
# A class of the core: BareTest finds the core's folder by it (a path repository's checkout).
core_class='Omnimap\Registry'
