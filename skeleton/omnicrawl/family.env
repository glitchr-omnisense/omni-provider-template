# What bin/init needs to know of the omnicrawl family.
core=omnisense/omnicrawl
core_repo=omnicrawl
core_constraint=^1.0
vendor_ns=Omnicrawl
branch=1.x
# No conformance suite wired: the skeleton answers nothing yet (its contract says "not written").
contract=''
# A class of the core: BareTest finds the core's folder by it (a path repository's checkout).
core_class='Omnicrawl\Registry'
