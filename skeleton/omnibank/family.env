# What bin/init needs to know of the omnibank family.
core=omnisense/omnibank
core_repo=omnibank
core_constraint=^1.0
vendor_ns=Omnibank
branch=1.x
# No conformance suite wired: the skeleton's gateway has no action yet (every request refused).
contract=''
# A class of the core: BareTest finds the core's folder by it (a path repository's checkout).
core_class='Omnibank\Registry'
# The class the CI loads and BareTest starts from: omnibank names its factories <Name>GatewayFactory.
entry='__Name__GatewayFactory'
