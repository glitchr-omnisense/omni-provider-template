# What bin/init needs to know of the omnisong family.
core=omnisense/omnisong
core_repo=omnisong
core_constraint=^1.0
vendor_ns=Omnisong
branch=1.x
# No conformance suite wired: the skeleton answers nothing yet (each method says "not written").
contract=''
# A class of the core: BareTest finds the core's folder by it (a path repository's checkout).
core_class='Omnisong\Registry'
# The class the CI loads and BareTest starts from: omnisong names its factories <Name>CatalogFactory.
entry='__Name__CatalogFactory'
