# What bin/init needs to know of the omnifood family.
core=omnisense/omnifood
core_repo=omnifood
core_constraint=^1.0
vendor_ns=Omnifood
branch=1.x
# No conformance suite wired: the skeleton implements none of the family's contracts yet.
contract=''
# A class of the core: BareTest finds the core's folder by it (a path repository's checkout).
core_class='Omnifood\Registry'
# The class the CI loads and BareTest starts from: omnifood names its factories <Name>PlatformFactory.
entry='__Name__PlatformFactory'
