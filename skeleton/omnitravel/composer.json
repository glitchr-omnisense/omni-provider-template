{
    "name": "__package__",
    "type": "library",
    "description": "__Title__ for omnitravel: public transport (timetables, journeys, vehicles, networks), under any PHP host.",
    "keywords": [
        "transit",
        "timetable",
        "gtfs",
        "__name__",
        "framework-agnostic",
        "omnitravel"
    ],
    "homepage": "https://github.com/__owner__/__repo__",
    "license": "MIT",
    "authors": [
        {
            "name": "__author__",
            "email": "__email__"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/contracts": "^1.0",
        "omnisense/omnitravel": "__core_constraint__"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "__Namespace_json__\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "__Namespace_json__\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-__branch__": "__branch__-dev"
        },
        "omnisense": {
            "policy": "policy.json"
        }
    },
    "config": {
        "sort-packages": true
    }
}
