# What bin/init needs to know of the omnisearch family.
core=omnisense/omnisearch
core_repo=omnisearch
core_constraint=^1.0@dev
vendor_ns=Omnisearch
branch=1.x
contract=DriverContractTests
# A class of the core: BareTest finds the core's folder by it (a path repository's checkout).
core_class='Omnisearch\Registry'
