# What bin/init needs to know of the omnidrive family.
core=omnisense/omnidrive
core_repo=omnidrive
core_constraint=^1.0@dev
vendor_ns=Omnidrive
branch=1.x
contract=DriveContractTests
# A class of the core: BareTest finds the core's folder by it (a path repository's checkout).
core_class='Omnidrive\Registry'
