# What bin/init needs to know of the omniauth family.
core=omnisense/omniauth
core_repo=omniauth
core_constraint=^1.0@dev
vendor_ns=Omniauth
branch=1.x
contract=ProviderContractTests
# A class of the core: BareTest finds the core's folder by it (a path repository's checkout).
core_class='Omniauth\Omniauth'
# The shared pieces of skeleton/parts/ it uses (parts/json: Data, the reader of decoded JSON).
parts=json
