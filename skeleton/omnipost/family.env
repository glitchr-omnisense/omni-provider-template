# What bin/init needs to know of the omnipost family.
core=omnisense/omnipost
core_repo=omnipost
core_constraint=^1.0
vendor_ns=Omnipost
branch=1.x
# No conformance suite wired: the skeleton answers nothing yet (its contract says "not written").
contract=''
# A class of the core: BareTest finds the core's folder by it (a path repository's checkout).
core_class='Omnipost\Registry'
# The class the CI loads and BareTest starts from: omnipost names its factories <Name>ProviderFactory.
entry='__Name__ProviderFactory'
