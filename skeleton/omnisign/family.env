# What bin/init needs to know of the omnisign family.
core=omnisense/omnisign
core_repo=omnisign
core_constraint=^1.2
vendor_ns=Omnisign
branch=1.x
# No conformance suite wired: the skeleton's gateway has no action yet (every request refused).
contract=''
# A class of the core: BareTest finds the core's folder by it (a path repository's checkout).
core_class='Omnisign\Registry'
# The class the CI loads and BareTest starts from: omnisign names its factories <Name>GatewayFactory.
entry='__Name__GatewayFactory'
