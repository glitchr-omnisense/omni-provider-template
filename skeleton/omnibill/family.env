# What bin/init needs to know of the omnibill family.
core=omnisense/omnibill
core_repo=omnibill
core_constraint=^1.3
vendor_ns=Omnibill
branch=1.x
# No conformance suite wired: the skeleton's gateway has no action yet (every request refused).
contract=''
# A class of the core: BareTest finds the core's folder by it (a path repository's checkout).
core_class='Omnibill\Registry'
# The class the CI loads and BareTest starts from: omnibill names its factories <Name>GatewayFactory.
entry='__Name__GatewayFactory'
