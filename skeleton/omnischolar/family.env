# What bin/init needs to know of the omnischolar family.
core=omnisense/omnischolar
core_repo=omnischolar
core_constraint=^1.0
vendor_ns=Omnischolar
branch=1.x
# No conformance suite wired: the skeleton answers nothing yet (each operation says "not written").
contract=''
# A class of the core: BareTest finds the core's folder by it (a path repository's checkout).
core_class='Omnischolar\Registry'
# The class the CI loads and BareTest starts from: omnischolar names its factories <Name>SourceFactory.
entry='__Name__SourceFactory'
