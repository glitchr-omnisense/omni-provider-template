# What bin/init needs to know of the omnibus family.
core=omnisense/omnibus
core_repo=omnibus
core_constraint=^2.0@dev
vendor_ns=Omnibus
branch=2.x
contract=GatewayContractTests
# A class of the core: BareTest finds the core's folder by it (a path repository's checkout).
core_class='Omnibus\Registry'
# The shared pieces of skeleton/parts/ it uses (parts/json: Data, the reader of decoded JSON).
parts=json
